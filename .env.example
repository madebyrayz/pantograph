# Pantograph — no API keys required.
# The agent runs on the `claude` CLI's own login; nothing secret lives here.

# TCP port of the listener running inside Rhino (rhino_side/pantograph_listener.py)
PANTOGRAPH_RHINO_PORT=9877

# Port the Next.js app serves on (mcp_server.py forwards graph tools here)
PANTOGRAPH_APP_PORT=3000
